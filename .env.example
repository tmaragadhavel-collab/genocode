# InterviewAI Configuration
# Copy this file to .env and add your values.

# Server port (default: 3001)
SERVER_PORT=3001

# Deepgram Speech-to-Text (REQUIRED for real audio transcription)
# Get your key at https://deepgram.com
DEEPGRAM_API_KEY=

# AI / LLM Provider (REQUIRED for real AI responses)
# Currently supports OpenAI-compatible APIs
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# LiveKit (REQUIRED for real interview audio)
# Get credentials at https://livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM request timeout in milliseconds for the interview chat (default: 30000)
AI_TIMEOUT_MS=30000

# Base URL used in interview invite links (e.g. an HTTPS tunnel). Defaults to the request host.
PUBLIC_BASE_URL=
