# InterviewAI configuration. Copy to .env and fill in values. Never commit .env.

NODE_ENV=development
SERVER_PORT=3001
# Base URL for invite links (e.g. an HTTPS tunnel). Defaults to the request host.
PUBLIC_BASE_URL=

# --- LLM (evaluation, follow-ups, chat, reports, live assistant) ---
# Primary provider, called through the OpenAI-compatible API (base URL swap).
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Must be a model your key can access (list: GET {LLM_BASE_URL}/models).
LLM_MODEL=openai/gpt-oss-120b
# Per-call timeout (ms) and retries on 429/5xx/timeout before falling back.
LLM_TIMEOUT_MS=20000
LLM_MAX_RETRIES=2

# Optional fallback provider (used after the primary's retries are exhausted).
LLM_FALLBACK_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# --- Speech-to-text ---
# Each browser streams its own microphone (16 kHz PCM16, binary WebSocket frames);
# the server runs one STT stream per participant.
# deepgram = real-time streaming with live partial transcripts (recommended)
# groq     = Groq Whisper; the server cuts utterances, finals only (no live partials)
# none     = no transcription (the interviewer can type answers)
STT_PROVIDER=deepgram
# Used automatically if the primary provider fails (e.g. bad key or outage).
STT_FALLBACK_PROVIDER=groq
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
# Groq Whisper model; uses LLM_API_KEY when LLM_PROVIDER=groq, or STT_API_KEY.
STT_MODEL=whisper-large-v3-turbo
STT_API_KEY=

# Seconds of candidate silence before the interviewer is asked to end the answer.
ANSWER_SILENCE_SECONDS=5

# --- Database (SQLite via Prisma). Relative paths are resolved from the project root.
DATABASE_URL=file:./data/interview.db

# --- LiveKit (video) ---
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
